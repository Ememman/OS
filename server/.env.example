# Optional. Without this, the Music app's "Full Song" search still works,
# just via an "Open on YouTube" link instead of an embedded results list —
# see README.md → "About the Music search feature" for why.
#
# To enable inline full-song search results:
# 1. Go to https://console.cloud.google.com/apis/library/youtube.googleapis.com
# 2. Create a project (free), enable "YouTube Data API v3"
# 3. Create an API key under Credentials, paste it below
YOUTUBE_API_KEY=

PORT=4000
