
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "os-portfolio",
  "compatibility_date": "2026-11-26",
  "routes": [
    { "pattern": "emman-os-portfolio.com", "custom_domain": true },
    { "pattern": "www.emman-os-portfolio.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
